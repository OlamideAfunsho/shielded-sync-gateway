# Pinned component versions.
#
# Source locations are not stored in this repo. scripts/build-deps.sh reads
# ZEBRA_REPO, ZAINO_REPO and ZINGOLIB_REPO from the environment: point them
# at the upstream git repositories (or local clones) of Zebra, Zaino and
# zingolib.
#
# This is the exact set zingolib v7.0.0 tests against (its
# .env.testing-artifacts, pinned 2026-09-28): zainod 0.10.1 built against
# zebra 6.3.0. Change one and you are testing a different system.

ZEBRA_TAG=v6.3.0

ZAINO_TAG=zainod-0.10.1
ZAINO_FEATURES=no_tls_use_unencrypted_traffic

ZINGOLIB_TAG=zingolib_v7.0.0
# zingo-cli 7 routes sends over the Nym mixnet and refuses to go online
# without it. A local regtest chain is not reachable through the mixnet, so
# we use the build zingolabs uses for its own sync benchmarks: no `nym`,
# plus `nakednet-test-mode`, which lets the session go online directly.
# Sync traffic is plain gRPC to the configured indexer in both builds, so
# the gateway sits in the same place either way.
ZINGO_CLI_FEATURES=nakednet-test-mode
